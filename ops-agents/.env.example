# ───────────────────────── Required ─────────────────────────
# Anthropic API key (the Agent SDK reads this automatically).
ANTHROPIC_API_KEY=sk-ant-...

# Slack app credentials (Socket Mode — no public URL needed).
# Bot token: api.slack.com/apps → OAuth & Permissions  (starts xoxb-)
SLACK_BOT_TOKEN=xoxb-...
# App-level token with connections:write  (starts xapp-)
SLACK_APP_TOKEN=xapp-...

# ──────────────── Channel → agent routing (required) ────────────────
# Right-click a channel in Slack → View channel details → bottom shows the ID.
# Leave any blank to disable that agent. The bot only acts when @-mentioned.
SLACK_SUPPORT_CHANNEL=C000SUPPORT
SLACK_PM_CHANNEL=C000PM
SLACK_DEV_CHANNEL=C000DEV
SLACK_MARKETING_CHANNEL=C000MKTG

# Where Approve/Reject prompts for sensitive actions are posted.
# If unset, they post into the originating thread.
SLACK_APPROVALS_CHANNEL=C000APPROVALS

# ──────────────── Integrations (all optional) ────────────────
# Each tool only registers if its env is present, so the bot runs fine with
# none of these — the agents simply reason + reply until you wire a tool.

# Dev agent — GitHub (issues/PRs). Classic or fine-grained PAT with repo scope.
GITHUB_TOKEN=
GITHUB_REPO=wilkowskij/real-estate-marketing-agent-

# Dev agent — Sentry (recent production errors). Auth token + org/project slugs.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# PM + Support agents — Linear (backlog / bug filing).
LINEAR_API_KEY=

# Support agent — Notion (internal knowledge base search).
NOTION_API_KEY=

# Marketing agent — drive YOUR OWN product to draft content (dogfooding).
# Point at your deployed app; the agent calls /api/campaigns/generate.
PRODUCT_API_URL=https://real-estate-marketing-agent-khaki.vercel.app
PRODUCT_API_TOKEN=
