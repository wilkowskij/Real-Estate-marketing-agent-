# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Model IDs
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# MLS / listing data (RentCast) — enables "Import from MLS" on Create. Optional.
RENTCAST_API_KEY=

# Image generation provider (pluggable). "stub" no-ops locally; "openai" uses gpt-image-1.
IMAGE_PROVIDER=stub
IMAGE_PROVIDER_API_KEY=
# OpenAI (used when IMAGE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Reel/video render provider (pluggable). "stub" returns a shot list only;
# "shotstack" renders an MP4 from the reel storyboard. Needs SHOTSTACK_API_KEY.
VIDEO_PROVIDER=stub
SHOTSTACK_API_KEY=
# "stage" (sandbox) or "v1" (production)
SHOTSTACK_ENV=stage

# Cron auth (Vercel Cron sends this as a Bearer token)
CRON_SECRET=

# Token encryption key for social_accounts (32-byte base64)
SOCIAL_TOKEN_ENC_KEY=

# Social platform OAuth (filled in once Meta/LinkedIn/X approvals land)
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X / Twitter API v2 OAuth 2.0 (PKCE). Client ID/secret from the X developer portal.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Public base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support / feedback → Notion (optional). Submissions are always stored in
# Postgres; when both are set they're also mirrored into a Notion database for
# triage. Create an internal integration at notion.so/my-integrations, share
# the target database with it, and use the database ID (the 32-char id in its
# URL). The DB needs a title property; optional "Type"/"Status" select and an
# "Email" property are filled in automatically when present.
NOTION_API_KEY=
NOTION_FEEDBACK_DB_ID=

# Stripe billing (Phase 1). Leave blank to run without billing (routes return 503).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Base recurring price per plan (Solo, Team, Brokerage)
STRIPE_PRICE_SOLO=
STRIPE_PRICE_TEAM=
STRIPE_PRICE_BROKERAGE=
# Per-additional-user recurring prices (one "licensed" recurring price each:
# $39/mo for Team, $32/mo for Brokerage). Used as a second subscription line item.
STRIPE_PRICE_TEAM_SEAT=
STRIPE_PRICE_BROKERAGE_SEAT=
