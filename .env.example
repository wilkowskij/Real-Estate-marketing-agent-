# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=
# Model IDs
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_FAST_MODEL=claude-haiku-4-5-20251001

# Image generation provider (pluggable). "stub" no-ops locally; "openai" uses gpt-image-1.
IMAGE_PROVIDER=stub
IMAGE_PROVIDER_API_KEY=
# OpenAI (used when IMAGE_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# Cron auth (Vercel Cron sends this as a Bearer token)
CRON_SECRET=

# Token encryption key for social_accounts (32-byte base64)
SOCIAL_TOKEN_ENC_KEY=

# Social platform OAuth (filled in once Meta/LinkedIn approvals land)
META_APP_ID=
META_APP_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Public base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
