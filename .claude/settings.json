{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(npm run build)",
      "Bash(npm run check:env)",
      "Bash(node scripts/check-env.mjs:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)"
    ],
    "ask": [
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout main)",
      "Bash(git merge:*)",
      "Bash(stripe:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.development)",
      "Read(./.env.development.local)",
      "Read(./.env.production)",
      "Read(./.env.production.local)",
      "Read(./ops-agents/.env)",
      "Read(./ops-agents/.env.local)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(rm -rf:*)",
      "Bash(vercel --prod:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db reset:*)"
    ]
  }
}
